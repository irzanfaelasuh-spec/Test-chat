rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function convo(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }
    function isMember(conversationId) {
      return signedIn() && convo(conversationId).data.members.hasAny([request.auth.uid]);
    }
    function notBlockedDirect(conversationId) {
      let data = convo(conversationId).data;
      return data.type != 'direct' || (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(data.members[0] == request.auth.uid ? data.members[1] : data.members[0])) &&
        !exists(/databases/$(database)/documents/users/$(data.members[0] == request.auth.uid ? data.members[1] : data.members[0])/blocks/$(request.auth.uid))
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if false;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'about', 'updatedAt', 'online', 'lastSeen'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 80;

      match /contacts/{contactUid} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.uid == contactUid
          && request.resource.data.shortName is string
          && request.resource.data.shortName.size() >= 1
          && request.resource.data.shortName.size() <= 16
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() >= 1
          && request.resource.data.fullName.size() <= 32;
        allow delete: if isSelf(uid);
      }
      match /blocks/{blockedUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && request.resource.data.token is string && request.resource.data.token.size() <= 4096;
        allow delete: if isSelf(uid);
      }
      match /hiddenMessages/{messageId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && request.resource.data.conversationId is string;
        allow delete: if isSelf(uid);
      }
    }

    match /usernames/{username} { allow read, write: if false; }
    match /numbers/{number} { allow read, write: if false; }

    match /conversations/{conversationId} {
      allow read: if isMember(conversationId);
      allow create, delete: if false;
      allow update: if isMember(conversationId) && notBlockedDirect(conversationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);

      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow create: if isMember(conversationId) && notBlockedDirect(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'video', 'audio', 'file', 'sticker']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(conversationId) && notBlockedDirect(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deliveredTo'])
          && request.resource.data.readBy is list
          && request.resource.data.deliveredTo is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo)
          && (request.resource.data.readBy.hasAny([request.auth.uid]) || request.resource.data.deliveredTo.hasAny([request.auth.uid]));
        allow delete: if false;
      }
      match /typing/{uid} {
        allow read: if isMember(conversationId);
        allow create, update: if isSelf(uid) && isMember(conversationId) && notBlockedDirect(conversationId)
          && request.resource.data.isTyping is bool;
        allow delete: if isSelf(uid) && isMember(conversationId) && notBlockedDirect(conversationId);
      }
    }

    match /statuses/{statusId} {
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/contacts/$(resource.data.uid))
      );
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['text', 'image', 'video']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
